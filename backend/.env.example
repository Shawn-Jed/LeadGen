# Kopiere nach backend/.env und fülle aus. .env wird NICHT eingecheckt.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine-adresse@gmail.com
SMTP_PASS=app-passwort-hier
SMTP_FROM=deine-adresse@gmail.com
# direct = echter Versand | draft = .eml ablegen (sicherer Default)
OUTREACH_SEND_MODE=draft

# Subsystem C — Prototyp (GitHub Pages)
# Lokaler Pfad zum ausgecheckten öffentlichen prototyp-Repo:
PROTOTYP_REPO_PATH=/pfad/zu/prototyp
# Basis-URL der Pages-Site (ohne abschließenden Slash):
PROTOTYP_PAGES_BASE=https://shawn-jed.github.io/prototyp
